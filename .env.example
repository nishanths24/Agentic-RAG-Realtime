# Copy to .env and fill in. NEVER commit .env.
DOCUMENTS_DIR=data/documents
INDEX_DIR=data/index
LOG_DIR=logs
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
MIN_SCORE=0.08
LOG_LEVEL=INFO
REQUEST_TIMEOUT_S=15
MAX_AGENT_STEPS=4
MAX_FILE_BYTES=1048576
MAX_QUESTION_CHARS=2000

EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=hashing-bow-v1
EMBEDDING_DIMENSION=384

# Optional: OpenAI-compatible LLM. Leave empty to use the extractive composer.
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Optional web search (not required for the demo).
SEARCH_API_KEY=

# Optional API write protection. Empty disables the header check (localhost only).
API_KEY=
HOST=127.0.0.1
PORT=8000
